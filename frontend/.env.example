# Copy to .env and fill in (never commit .env).
# Supabase — Project Settings → Data API → Project URL + anon public key.
# URL must be the BARE project URL (https://<ref>.supabase.co) — NOT the
# REST endpoint (no /rest/v1 suffix); that breaks every call with PGRST125.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API override for production builds (Vercel/Render).
# Local dev uses the Vite proxy (/api -> localhost:8000), so leave empty.
# VITE_API_BASE_URL=https://your-backend.onrender.com
