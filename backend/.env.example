# Postgres connection. Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/quant_trading

# Free Groq API key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Any OpenAI-compatible model id Groq serves, e.g. llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Market for backtests. Only NIFTY50 is wired up.
DEFAULT_MARKET=NIFTY50

# Days a cached OHLCV CSV stays fresh before re-downloading from Yahoo Finance.
MARKET_DATA_REFRESH_DAYS=1

# Sandbox backstops for the backtest worker. Memory cap is POSIX-only.
# Must stay >= ~1536: pandas/numpy/backtrader cannot import under a smaller
# address-space cap, which kills the worker before it runs the strategy.
SANDBOX_MEMORY_MB=2048
# SANDBOX_CPU_SECONDS=

# Paper-trading approval gate: minimum closed trades and max drawdown cap.
APPROVAL_MIN_TRADES=1
APPROVAL_MAX_DRAWDOWN_PCT=50.0

# ---------------------------------------------------------------- News Hub
# The hub works with no keys: Google News RSS, official RSS/Atom feeds and
# Reddit's public JSON are keyless. These keys are optional extras.
# MARKETAUX_API_KEY=       # https://www.marketaux.com
# FINNHUB_API_KEY=         # https://finnhub.io
# ALPHA_VANTAGE_API_KEY=   # https://www.alphavantage.co/support/#api-key

# Background refresh cadence, retention and source toggles.
NEWS_REFRESH_MINUTES=30
NEWS_RETENTION_DAYS=7
NEWS_MAX_ARTICLES=3000
NEWS_ENABLE_REDDIT=true
NEWS_ENABLE_GOOGLE_NEWS=true
NEWS_AUTO_REFRESH=true
NEWS_AUTO_REFRESH_INITIAL_DELAY_SECONDS=20
NEWS_RSS_TIMEOUT_SECONDS=20
# Reddit expects a descriptive User-Agent with contact details.
# NEWS_USER_AGENT=
# REDDIT_USER_AGENT=
