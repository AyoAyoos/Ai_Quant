# Postgres connection. Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/quant_trading

# Free Groq API key: https://console.groq.com
GROQ_API_KEY=

# Any OpenAI-compatible model id Groq serves, e.g. llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Market for backtests. Only NIFTY50 is wired up.
DEFAULT_MARKET=NIFTY50

# Days a cached OHLCV CSV stays fresh before re-downloading from Yahoo Finance.
MARKET_DATA_REFRESH_DAYS=1
